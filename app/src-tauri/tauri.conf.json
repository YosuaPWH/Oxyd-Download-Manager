{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxyd Download Manager",
  "mainBinaryName": "Oxyd",
  "version": "0.1.3",
  "identifier": "com.oxyd.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oxyd Download Manager",
        "width": 1100,
        "height": 700,
        "minWidth": 780,
        "minHeight": 480,
        "visible": true,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Oxyd Download Manager contributors",
    "shortDescription": "Fast segmented download manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
